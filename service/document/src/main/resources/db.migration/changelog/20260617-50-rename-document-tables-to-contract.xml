    <!-- Jadvallarni "contract_*" nomiga ko'chirish (faqat jadval nomi). ALTER TABLE IF EXISTS
         idempotent (PG14+). DO $$ ishlatilmaydi — Liquibase splitStatements dollar-quote'ni buzadi. -->
    <changeSet id="20260617-50-rename-document-tables-to-contract" author="qodiriy">
        <validCheckSum>ANY</validCheckSum>
        <sql>
            ALTER TABLE IF EXISTS document.document_value RENAME TO contract_value;
            ALTER TABLE IF EXISTS document.document_witness RENAME TO contract_witness;
            ALTER TABLE IF EXISTS document.payment_schedule RENAME TO contract_payment;
        </sql>
    </changeSet>

</databaseChangeLog>
