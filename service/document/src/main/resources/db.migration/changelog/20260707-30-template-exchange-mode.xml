    <!-- Shablon oldi-berdi turi: GOODS (mahsulot, soni) yoki MONEY (qarz, summa).
         Default GOODS — mavjud shablonlar hozirgidek ishlaydi. -->
    <changeSet id="20260707-30-template-exchange-mode" author="qodiriy">
        <validCheckSum>ANY</validCheckSum>
        <sql>
            ALTER TABLE "document".contract_template
                ADD COLUMN IF NOT EXISTS exchange_mode VARCHAR(16) NOT NULL DEFAULT 'GOODS';
        </sql>
    </changeSet>
</databaseChangeLog>
