<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- Shartnoma raqami uchun kunlik ketma-ket hisoblagich (YYMMDD-NNNN).
         seq_date PK + atomik UPSERT+RETURNING → concurrency-safe, unikal. -->
    <changeSet id="20260610-00-create-document-seq" author="qodiriy">
        <sql>
            CREATE TABLE IF NOT EXISTS document.document_seq (
                seq_date DATE PRIMARY KEY,
                last_no  INTEGER NOT NULL DEFAULT 0
            );
        </sql>
    </changeSet>

</databaseChangeLog>
