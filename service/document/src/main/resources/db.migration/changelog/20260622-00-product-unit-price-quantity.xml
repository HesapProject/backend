<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- Sotuv shartnomasi mahsulotlari: o'lchov birligi (enum), birlik narxi va soni.
         amount = price * quantity (tiyin). -->
    <changeSet id="20260622-00-product-unit-price-quantity" author="qodiriy">
        <validCheckSum>ANY</validCheckSum>
        <sql>
            ALTER TABLE document.products ADD COLUMN IF NOT EXISTS unit     TEXT;
            ALTER TABLE document.products ADD COLUMN IF NOT EXISTS price    NUMERIC;
            ALTER TABLE document.products ADD COLUMN IF NOT EXISTS quantity NUMERIC;
        </sql>
    </changeSet>

</databaseChangeLog>
