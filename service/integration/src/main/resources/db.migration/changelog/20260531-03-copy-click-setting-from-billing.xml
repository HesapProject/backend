<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- Mavjud Click credential'lari billing.payment'dan ko'chiriladi. -->
    <changeSet id="20260531-03-copy-click-setting-from-billing" author="claude">
        <preConditions onFail="MARK_RAN">
            <tableExists schemaName="billing" tableName="payment"/>
        </preConditions>
        <sql>
            INSERT INTO integration.click_setting (service_id, merchant_id, secret_key)
            SELECT click_service_id, click_merchant_id, click_key
            FROM billing.payment
            WHERE deleted = false AND click_merchant_id IS NOT NULL
            LIMIT 1;
        </sql>
    </changeSet>
</databaseChangeLog>
