<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- MyID mobil SDK kaliti (MyID jamoasi bergan). Mobil token/session/data
         chaqiruvlari shu client_id/client_secret bilan ishlaydi. base_url=myid.uz
         (mijozga moslangan host). Bo'sh mobile_client_secret sabab token
         'client_secret: Input should be valid string' xatosini berardi. -->
    <changeSet id="20260618-00-seed-myid-mobile-credentials" author="qodiriy">
        <validCheckSum>ANY</validCheckSum>
        <sql>
            UPDATE integration.myid_setting SET
                base_url             = 'https://myid.uz',
                mobile_client_id     = 'CHANGE_ME',
                mobile_client_secret = 'CHANGE_ME';

            INSERT INTO integration.myid_setting (base_url, mobile_client_id, mobile_client_secret)
            SELECT 'https://myid.uz',
                   'CHANGE_ME',
                   'CHANGE_ME'
            WHERE NOT EXISTS (SELECT 1 FROM integration.myid_setting);
        </sql>
    </changeSet>
</databaseChangeLog>
