<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- Pasport detallari: kim bergan (give_place), berilgan va amal qilish sanasi.
         Legacy passport jadvalidan ko'chiriladi. Sanalar birthday kabi ISO matn (YYYY-MM-DD). -->
    <changeSet id="20260617-40-add-user-passport-detail-fields" author="qodiriy">
        <sql>
            ALTER TABLE "user".user
                ADD COLUMN IF NOT EXISTS passport_issued_by   TEXT,
                ADD COLUMN IF NOT EXISTS passport_issue_date  TEXT,
                ADD COLUMN IF NOT EXISTS passport_expiry_date TEXT;
        </sql>
    </changeSet>

</databaseChangeLog>
