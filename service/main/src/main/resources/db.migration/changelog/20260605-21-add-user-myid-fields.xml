<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- MyID verify oqimidan profilni boyitish: permanent_registration bloki
         alohida JSON (address_json) + common_data skalyarlari. /me'da qaytariladi. -->
    <changeSet id="20260605-21-add-user-myid-fields" author="system">
        <sql>
            ALTER TABLE "user".user
                ADD COLUMN IF NOT EXISTS address_json TEXT,
                ADD COLUMN IF NOT EXISTS birth_place  TEXT,
                ADD COLUMN IF NOT EXISTS nationality  TEXT,
                ADD COLUMN IF NOT EXISTS citizenship  TEXT;
        </sql>
    </changeSet>

</databaseChangeLog>
